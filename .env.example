# Copie para .env.local e preencha. Chave em https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# E-mail da Nexo que recebe os contatos do formulário
CONTACT_TO_EMAIL=contato@exemplo.com
# Opcional. Sem domínio verificado no Resend, use o remetente de teste abaixo
# (ele só entrega para o e-mail dono da conta Resend).
CONTACT_FROM_EMAIL=nexo.menu <onboarding@resend.dev>
